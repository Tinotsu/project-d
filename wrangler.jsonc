{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LEVEL_AUDIO",
      "bucket_name": "project-d-level-audio"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "AUTH_EMAIL_FROM"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
